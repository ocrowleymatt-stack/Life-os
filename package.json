{
  "name": "daedalus-workshop",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Mnemosyne Factory workshop UI and API.",
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "dev:api": "python -m uvicorn app.main:app --app-dir apps/api --host 0.0.0.0 --port 8010"
  },
  "workspaces": [
    "apps/web"
  ]
}
